{
  "name": "lean-tests",
  "title": "lean tests: {{scope}}",
  "vars": {
    "scope": { "doc": "what the wave may cut (one line: test files / an area; the analysis names the candidates inside it)" },
    "lane": { "doc": "the lane name" },
    "worktree": { "doc": "the wave worktree (its branch = branch)" },
    "branch": { "doc": "the wave branch (feat/lean-...)" },
    "notes_dir": { "doc": "durable folder for the step NOTES (outside every worktree)" },
    "base": { "default": "origin/main", "doc": "the commit the wave is measured against (the gate's --base)" }
  },
  "defaults": { "lane": "{{lane}}", "worktree": "{{worktree}}" },
  "steps": [
    { "id": "analyse", "title": "lean tests - analyse: {{scope}}", "class": "planner", "budget_min": 60, "notes": "{{notes_dir}}/ANALYSE-NOTES.md", "brief_template": "templates/lean-analyse.md" },
    { "id": "wave", "title": "lean tests - wave: {{scope}}", "needs": ["analyse"], "class": "sol", "budget_min": 90, "notes": "{{notes_dir}}/WAVE-NOTES.md", "brief_template": "templates/lean-wave.md" },
    { "id": "verify", "title": "lean tests - verify the wave: {{scope}}", "needs": ["wave"], "class": "implementer", "budget_min": 45, "notes": "{{notes_dir}}/VERIFY-NOTES.md", "brief_template": "templates/lean-verify.md" }
  ]
}
