{
  "name": "spec-then-build",
  "title": "spec then build: {{topic}}",
  "vars": {
    "topic": { "doc": "what to specify and build (one line)" },
    "lane": { "doc": "the lane name" },
    "worktree": { "doc": "the build worktree (its branch = branch)" },
    "branch": { "doc": "the build branch (feat/...)" },
    "notes_dir": { "doc": "durable folder for the step NOTES and the SPEC (outside every worktree)" },
    "context": { "default": "", "doc": "files / plan sections the planner reads first" },
    "decision": { "default": "", "doc": "ask var: the owner Q the planner raised (norn flow resume EP-n --var decision=Q-n)" },
    "ui": { "default": "", "doc": "non-empty = the build changes the dash / UI (merge shots)" }
  },
  "defaults": { "lane": "{{lane}}", "worktree": "{{worktree}}" },
  "steps": [
    { "id": "spec", "title": "SPEC {{topic}}", "class": "planner", "ask": "decision", "budget_min": 90, "notes": "{{notes_dir}}/SPEC-NOTES.md", "brief_template": "templates/spec.md" },
    { "id": "build", "title": "build {{topic}}", "needs": ["spec"], "class": "implementer", "budget_min": 240, "notes": "{{notes_dir}}/BUILD-NOTES.md", "brief_template": "templates/build.md" },
    {
      "id": "merge", "title": "MERGE {{branch}}", "needs": ["build"], "class": "implementer", "stage": "MERGE", "budget_min": 60,
      "notes": "{{notes_dir}}/MERGE-NOTES.md",
      "brief_template": { "builtin": "merge", "args": { "lane": "{{lane}}", "branch": "{{branch}}", "worktree": "{{worktree}}", "notes": "{{notes_dir}}/MERGE-NOTES.md", "ui": "{{ui}}" } }
    }
  ]
}
