{
  "name": "art-round",
  "title": "art round: {{subject}}",
  "vars": {
    "subject": { "doc": "what to generate (one line: the asset, its use, the look target)" },
    "lane": { "doc": "the lane name" },
    "worktree": { "doc": "the worktree the generator / vendor work in" },
    "out_dir": { "doc": "durable folder for the candidates, the contact sheet and the step NOTES" },
    "dest": { "doc": "where the picked asset is vendored (repo path inside the worktree)" },
    "count": { "default": "6", "doc": "how many candidates to generate" },
    "refs": { "default": "", "doc": "reference images / boards the round matches" },
    "pick": { "default": "", "doc": "ask var: the owner_only pick Q the critique raised (norn flow resume EP-n --var pick=Q-n)" }
  },
  "defaults": { "lane": "{{lane}}", "worktree": "{{worktree}}" },
  "steps": [
    { "id": "generate", "title": "generate {{count}} candidates: {{subject}}", "class": "implementer", "budget_min": 90,
      "notes": "{{out_dir}}/GENERATE-NOTES.md", "brief_template": "templates/art-generate.md" },
    { "id": "critique", "title": "critique + owner pick: {{subject}}", "needs": ["generate"], "class": "implementer", "ask": "pick", "budget_min": 45,
      "notes": "{{out_dir}}/CRITIQUE-NOTES.md", "brief_template": "templates/art-critique.md" },
    { "id": "vendor", "title": "vendor the pick: {{subject}}", "needs": ["critique"], "class": "implementer", "budget_min": 60,
      "notes": "{{out_dir}}/VENDOR-NOTES.md", "brief_template": "templates/art-vendor.md" }
  ]
}
