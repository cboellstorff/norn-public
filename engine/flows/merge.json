{
  "name": "merge",
  "title": "merge {{branch}} (lane {{lane}})",
  "vars": {
    "lane": { "doc": "the lane whose branch merges" },
    "branch": { "doc": "the lane branch (feat/...)" },
    "worktree": { "doc": "the lane worktree" },
    "notes": { "doc": "the MERGE NOTES file (durable, outside every worktree)" },
    "ui": { "default": "", "doc": "non-empty = the branch changes the dash / UI (the merge takes shots per policy.merge.shots)" },
    "sha": { "default": "", "doc": "a tested commit: the staged merge in the main checkout (norn merge-brief --sha)" },
    "after": { "default": "", "doc": "after terms the merge waits for, e.g. run:RUN-n:done (empty = merge now)" }
  },
  "steps": [
    {
      "id": "merge",
      "title": "MERGE {{branch}}",
      "needs": ["{{after}}"],
      "class": "implementer",
      "stage": "MERGE",
      "lane": "{{lane}}",
      "worktree": "{{worktree}}",
      "notes": "{{notes}}",
      "budget_min": 60,
      "brief_template": { "builtin": "merge", "args": { "lane": "{{lane}}", "branch": "{{branch}}", "worktree": "{{worktree}}", "notes": "{{notes}}", "ui": "{{ui}}", "sha": "{{sha}}" } }
    }
  ]
}
